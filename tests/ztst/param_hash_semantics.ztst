#!/usr/bin/env zsh
# ztst-style checks for Param/Hash behaviors used by $parameters like ZI_REPORTS

set -euo pipefail
emulate -L zsh

: ${ZPMOD_STAGE_MODULE_DIR:?ZPMOD_STAGE_MODULE_DIR required}
module_path=("$ZPMOD_STAGE_MODULE_DIR" ${module_path[@]:-})
if ! zmodload -i zpmod; then
  print -u2 -- "failed to load module"
  exit 1
fi

ztst_suite "param-hash"

# Prepare associative param required by module: ZI_REPORTS must exist
typeset -gA ZI_REPORTS
ZI_REPORTS=( pluginA "foo" )

# Validate: appending via `zpmod report-append` to unknown yields non-zero status
ztst_it "report-append missing plugin -> error" \
  --cmd $'zpmod report-append missing "x"' \
  --stdout $'' --status 1

# We cannot easily redirect ZI_REPORTS binding from shell; keep this ztst minimal.
