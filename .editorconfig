# EditorConfig for zpmod: https://editorconfig.org
#
# zpmod is a compiled Zsh module. The languages actually present in this
# repository are C (src/), Zsh (tests/, src/completion/), CMake, POSIX sh
# (scripts/, docker/), Markdown, YAML, and Dockerfiles. Sections for languages
# this repository does not contain are intentionally absent.
#
# Indentation here must agree with the Trunk formatters in .trunk/configs,
# because shfmt and clang-format both read .editorconfig:
#   - C sources follow .trunk/configs/.clang-format (IndentWidth 4).
#   - Shell scripts use two spaces, matching the repository's Git whitespace
#     policy (which rejects tabs in added indentation). shfmt is configured with
#     `-i 2` in .trunk/trunk.yaml so the tools agree.
#
# Note: Zsh users should use alternate marks [[[ and ]]] as the original ones
# can confuse nested substitutions, e.g.: ${${${VAR}}}
#
# -*- mode: zsh; sh-indentation: 2; indent-tabs-mode: nil; sh-basic-offset: 2; -*-
# vim: ft=zsh sw=2 ts=2 et

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# C sources and headers. Must match IndentWidth/UseTab in
# .trunk/configs/.clang-format.
[*.{c,h}]
indent_size = 4

# Zsh sources: plugin code, test suites, and completions.
[*.{zsh,ztst}]
indent_size = 2

[_*]
indent_size = 2

# POSIX sh helper scripts.
[*.sh]
indent_size = 2

# Build system.
[{CMakeLists.txt,*.cmake,*.cmake.in}]
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4

# Docs and data. Trailing whitespace is significant in Markdown line breaks.
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[Dockerfile*]
indent_size = 4

[*.Dockerfile]
indent_size = 4
