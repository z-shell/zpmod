#compdef zpmod

_arguments \
  '-h[show help]' \
  '-V[show version]' \
  '1:subcommand:(report-append source-study dir-list path-stat read-file path-warmup)' \
  '*::args:->args'

case $state in
  args)
    case $words[2] in
      report-append)
        _arguments '2:plugin-id:_guard "^-*" plugin' '3:body:->body'
        ;;
      source-study)
        _arguments '-l[show full paths]'
        ;;
      dir-list)
        _arguments '-a[include dotfiles]' '-d[only directories]' '-f[only files]' \
          '2:out-array:_parameters -g "*"' '3:dir:_directories'
        ;;
      path-stat)
        _arguments '-L[follow symlinks]' '-f+[fields (comma-separated)]' \
          '2:out-array:_parameters -g "*"' '3:in-array:_parameters -g "*"'
        ;;
      read-file)
        _arguments '-m[use mmap]' '-0[NUL delimiter]' '-d+[delimiter]' \
          '2:var name:_parameters -g "*"' '3:file:_files'
        ;;
      path-warmup)
  _arguments '-q[quiet]' '--prune-missing[prune missing PATH entries]' '--dry-run[show what would be pruned without changing $path]'
        ;;
    esac
  ;;
end
